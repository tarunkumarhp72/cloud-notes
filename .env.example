# =============================================================
# Notepad Cloud - Root Environment Variables Template (.env.example)
# Use this when running locally or deploying as a single unified Vercel project.
# =============================================================

# Server & Client URLs
PORT=3001
FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=296554810612-c37vloj4db0re3ocqhg5ah22a7etfr4b.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
VITE_GOOGLE_CLIENT_ID=296554810612-c37vloj4db0re3ocqhg5ah22a7etfr4b.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# (Optional) Frontend API Base URL (empty for same-origin or local proxy)
VITE_API_BASE_URL=

# JWT & Authentication
JWT_SECRET=your-256-bit-random-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=15d
REFRESH_COOKIE_MAX_AGE_SEC=1296000
REFRESH_COOKIE_PATH=/auth
COOKIE_SAMESITE=Strict

# Supabase PostgreSQL Connection Pooler (Port 5432)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_SEC=20
DB_CONNECT_TIMEOUT_SEC=10
DB_SSL=require

# Rate Limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_SYNC_WINDOW_MS=60000
RATE_LIMIT_SYNC_MAX=180

# Note Limits & Safeguards
MAX_NOTES_PER_USER=50
MAX_NOTE_PAYLOAD_BYTES=5000000

# In-Memory LRU Cache
CACHE_TOKEN_MAX_ITEMS=1000
CACHE_TOKEN_TTL_MS=300000
