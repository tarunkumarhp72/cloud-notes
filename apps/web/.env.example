# -------------------------------------------------------------
# Notepad Cloud - Frontend Web Client Environment Variables
# -------------------------------------------------------------

# Google OAuth 2.0 Client ID (Created in Google Cloud Console for Web application)
VITE_GOOGLE_CLIENT_ID=296554810612-c37vloj4db0re3ocqhg5ah22a7etfr4b.apps.googleusercontent.com

# Google OAuth Redirect URI (Must match Authorized redirect URIs in GCP Console)
# For local development: http://localhost:3000/auth/callback
# For production on Vercel: https://<your-frontend-domain>.vercel.app/auth/callback
VITE_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# (Optional) Backend API Base URL
# Leave empty ("") if deploying as a single unified Vercel project or during local dev (uses Vite proxy /api)
# Set to "https://<your-api-domain>.vercel.app" if deploying frontend and backend as two separate Vercel projects
VITE_API_BASE_URL=
