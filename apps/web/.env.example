# Google OAuth 2.0 PKCE Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=https://your-frontend.vercel.app/auth/callback

# API Backend Base URL (e.g. https://your-api.vercel.app or empty if served on same domain)
VITE_API_BASE_URL=https://your-api.vercel.app

# Note Limits (Dynamic via .env)
VITE_GUEST_NOTE_LIMIT=10
VITE_USER_NOTE_LIMIT=50
VITE_MAX_NOTE_CHARS=100000

# Auto-save Timers (ms)
VITE_AUTOSAVE_DEBOUNCE_MS=1000
VITE_AUTOSAVE_MAX_WAIT_MS=10000
