{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @notepad/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://cloud-notes-api-seven.vercel.app/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://cloud-notes-api-seven.vercel.app/auth/$1"
    },
    {
      "source": "/sync/(.*)",
      "destination": "https://cloud-notes-api-seven.vercel.app/sync/$1"
    },
    {
      "source": "/account/(.*)",
      "destination": "https://cloud-notes-api-seven.vercel.app/account/$1"
    },
    {
      "source": "/health",
      "destination": "https://cloud-notes-api-seven.vercel.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
